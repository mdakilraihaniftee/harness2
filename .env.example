# Harness² deployment settings. Copy to .env and fill in.
# Shell environment variables take precedence over values in this file.
# The local demo (harness2-demo) needs none of these.

# --- Vertex AI ----------------------------------------------------------------
# Authenticate with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# Defaults to "global".
GOOGLE_CLOUD_LOCATION=global

# --- Models -------------------------------------------------------------------
# Executor model, in OpenCode's provider/model format.
# WorkBuddy setup requires a google-vertex/gemini... ID.
HARNESS2_SOLVER_MODEL=google-vertex/gemini-3.5-flash
# Improver (editor / composer / reflector) model, same format.
# Defaults to the executor model when empty.
HARNESS2_IMPROVER_MODEL=
# Bare judge model ID; the benchmark adapter adds the Vertex prefix.
HARNESS2_JUDGE_MODEL=gemini-3.5-flash

# Optional provider credentials. Only the selected provider's credential is forwarded.
# Never put credentials in model_profiles.toml.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Provider-neutral profiles use environment indirection so this repository never guesses
# current model IDs. Use identifiers verified in your provider account/runtime.
# HARNESS2_GPT_MODEL=openai/<verified-model-id>
# HARNESS2_GPT_JUDGE_MODEL=openai/<verified-judge-id>
# HARNESS2_QWEN_MODEL=openrouter/qwen/<verified-model-id>
# HARNESS2_QWEN_JUDGE_MODEL=openrouter/<verified-judge-id>

# Optional OpenAI-compatible route (local vLLM or hosted service).
# HARNESS2_CUSTOM_MODEL=custom/<endpoint-model-id>
# HARNESS2_CUSTOM_BASE_URL=http://127.0.0.1:8000/v1
# HARNESS2_CUSTOM_API_KEY=
# HARNESS2_MODEL_PROFILES=/absolute/path/to/model_profiles.toml

# --- Output -------------------------------------------------------------------
# Results root; defaults to runs/. Use a fresh directory per model/task selection.
# HARNESS2_RUNS_DIR=runs

# --- Optional: JobBench judge on a non-Vertex OpenAI-compatible endpoint ------
# HARNESS2_JUDGE_BASE_URL=
# HARNESS2_JUDGE_API_KEY=

# --- Optional: Codex executor (--substrate cx) --------------------------------
# harness2-bridge prints these values; or point them at another Responses API endpoint.
# HARNESS2_CODEX_BASE_URL=
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_MODEL=
# WorkBuddy only (the bridge must listen on 0.0.0.0):
# HARNESS2_CODEX_CONTAINER_URL=
